# =============================================================================
# CrashBet Hub — Production Environment Variables
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL connection string
MYSQL_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get these from your Clerk dashboard → API Keys
CLERK_SECRET_KEY=your-clerk-secret-key-here
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here

# Frontend Clerk settings (used at build time by Vite)
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key-here
VITE_CLERK_PROXY_URL=https://aviator.betcheza.co.ke/api/__clerk

# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── PayHero (M-PESA payments) ─────────────────────────────────────────────────
# Basic Auth token from your PayHero dashboard (include the "Basic " prefix)
PAYHERO_BASIC_AUTH=Basic YOUR_BASE64_ENCODED_CREDENTIALS
# Channel ID from PayHero dashboard
PAYHERO_CHANNEL_ID=7470
# Your PayHero account ID
PAYHERO_ACCOUNT_ID=5107
# Base URL PayHero will POST callbacks to (your production domain, no trailing slash)
PAYHERO_CALLBACK_BASE_URL=https://aviator.betcheza.co.ke

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=your@email.com
# Comma-separated Clerk user IDs to grant admin (use when real email isn't in JWT)
ADMIN_CLERK_IDS=user_xxxxxxxxxxxxxxxxxxxx
LOG_LEVEL=info

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Used for deposit approval notifications. If not set, emails are skipped.
SMTP_HOST=mail.betcheza.co.ke
SMTP_PORT=465
SMTP_USER=no-reply@betcheza.co.ke
SMTP_PASS=your-email-password
SMTP_FROM=PantaneAX <no-reply@betcheza.co.ke>
