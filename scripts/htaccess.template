Options -MultiViews
RewriteEngine On

# ── React SPA fallback ────────────────────────────────────────────────────────
# Serve index.html for any path that isn't a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ── API proxy is handled via DirectAdmin custom Apache config ─────────────────
# See scripts/apache-vhost.conf for the ProxyPass directives to add
